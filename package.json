{
  "name": "percival",
  "author": "Andrew Ford",
  "version": "2.0.0",
  "license": "MIT",
  "keywords": [
    "pebble-app"
  ],
  "private": true,
  "dependencies": {
    "@rebble/clay": "^1.0.8"
  },
  "pebble": {
    "displayName": "Percival",
    "uuid": "e18ac84c-91e9-4b27-bf5b-ff5b85e6e85a",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "targetPlatforms": [
      "emery"
    ],
    "projectType": "native",
    "watchapp": {
      "watchface": true
    },
    "capabilities": [
      "configurable",
      "location"
    ],
    "messageKeys": {
      "TEMPERATURE": 0,
      "TEMP_HIGH": 1,
      "TEMP_LOW": 2,
      "CITY": 3,
      "PrimaryColor": 4,
      "SUNSET": 5,
      "MiniCompLeft": 6,
      "MiniCompMiddle": 7,
      "MiniCompRight": 8,
      "SUNRISE": 9,
      "BottomCompLeft": 10,
      "BottomCompPrimary": 11,
      "BottomCompRight": 12,
      "TempUnit": 13,
      "UV_INDEX": 14,
      "Canvas": 15,
      "CONDITION": 16,
      "SUNRISE_MIN": 17,
      "SUNSET_MIN": 18,
      "IcsUrl": 19,
      "EVENT_DAY": 20,
      "EVENT_START_MIN": 21,
      "EVENT_TITLE": 22,
      "EVENT_LOCATION": 23
    },
    "resources": {
      "media": [
        {
          "type": "png",
          "name": "MENU_ICON",
          "file": "images/menu_icon.png",
          "menuIcon": true
        },
        {
          "type": "font",
          "name": "FONT_INTER_SEMIBOLD_14",
          "file": "fonts/Inter-SemiBold.ttf",
          "characterRegex": "[ -~·]"
        },
        {
          "type": "font",
          "name": "FONT_INTER_SEMIBOLD_16",
          "file": "fonts/Inter-SemiBold.ttf",
          "characterRegex": "[ -~·À-ÿ]"
        },
        {
          "type": "font",
          "name": "FONT_INTER_SEMIBOLD_18",
          "file": "fonts/Inter-SemiBold.ttf",
          "characterRegex": "[ -~°↑↓]"
        },
        {
          "type": "font",
          "name": "FONT_INTER_EXTRABOLD_20",
          "file": "fonts/Inter-ExtraBold.ttf",
          "characterRegex": "[ -~À-ÿ]"
        },
        {
          "type": "font",
          "name": "FONT_INTER_EXTRABOLD_40",
          "file": "fonts/Inter-ExtraBold.ttf",
          "characterRegex": "[0-9°\\- ]"
        },
        {
          "type": "font",
          "name": "FONT_INTER_EXTRABOLD_68",
          "file": "fonts/Inter-ExtraBold.ttf",
          "characterRegex": "[0-9: ]"
        }
      ]
    }
  }
}
